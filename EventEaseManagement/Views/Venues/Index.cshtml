@model IEnumerable<EventEaseManagement.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-header"><i class="fas fa-building" style="color: #007aff;"></i> Venues</h1>
    <a asp-action="Create" class="btn btn-ios-primary">
        <i class="fas fa-plus"></i> Add Venue
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center" style="border-radius: 16px;">
        <i class="fas fa-info-circle"></i> No venues yet. Start by adding one.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var venue in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-ios h-100">
                    @if (!string.IsNullOrEmpty(venue.ImageUrl))
                    {
                        <img src="@venue.ImageUrl" class="card-img-top" alt="@venue.VenueName" style="height: 200px; object-fit: cover; border-radius: 16px 16px 0 0;" />
                    }
                    else
                    {
                        <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 200px; border-radius: 16px 16px 0 0;">
                            <i class="fas fa-building fa-4x text-white-50"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@venue.VenueName</h5>
                        <p class="text-muted">
                            <i class="fas fa-map-marker-alt" style="color: #007aff;"></i> @venue.Location
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-users" style="color: #007aff;"></i> Capacity: <strong>@venue.Capacity</strong>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn-ios-outline btn-sm flex-grow-1">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <button onclick="deleteVenue(@venue.VenueId, '@venue.VenueName')" class="btn btn-ios-danger btn-sm flex-grow-1">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function deleteVenue(id, name) {
            Swal.fire({
                title: 'Delete Venue?',
                text: `Remove "${name}" and all associated bookings?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff3b30',
                cancelButtonColor: '#8e8e93',
                confirmButtonText: 'Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Venues/Delete/${id}`;
                }
            });
        }
    </script>
}