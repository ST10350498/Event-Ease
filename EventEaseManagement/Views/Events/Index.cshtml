@model IEnumerable<EventEaseManagement.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-calendar-alt text-primary"></i> Events</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle"></i> No events yet. Click "Add New Event" to get started.
    </div>
}
else
{
    <div class="row">
        @foreach (var eventItem in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(eventItem.ImageUrl))
                    {
                        <img src="@eventItem.ImageUrl" class="card-img-top" alt="@eventItem.EventName" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fas fa-calendar-alt fa-4x text-white-50"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@eventItem.EventName</h5>
                        <p class="card-text text-muted">
                            <i class="fas fa-calendar-day"></i> Start: @eventItem.StartDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="card-text text-muted">
                            <i class="fas fa-calendar-day"></i> End: @eventItem.EndDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="card-text">@(eventItem.Description?.Length > 100 ? eventItem.Description.Substring(0, 100) + "..." : eventItem.Description)</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="btn-group w-100">
                            <a asp-action="Edit" asp-route-id="@eventItem.EventId" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@eventItem.EventId" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            <button onclick="deleteEvent(@eventItem.EventId, '@eventItem.EventName')" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function deleteEvent(id, name) {
            Swal.fire({
                title: 'Delete Event?',
                text: `Are you sure you want to delete "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Events/Delete/${id}`;
                }
            });
        }
    </script>
}